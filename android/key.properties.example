# Copy this file to `key.properties` (same folder) and fill in your own
# release keystore details before running `flutter build appbundle` for a
# real Play Store upload. Never commit the real key.properties or your
# .jks keystore file to a public repo.
#
# Create a keystore first, e.g.:
#   keytool -genkey -v -keystore ~/tap-and-learn-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias taplearn
#
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=taplearn
storeFile=/absolute/path/to/tap-and-learn-release.jks
